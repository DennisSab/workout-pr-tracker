# Copy this file to .env.local for local development. Never put production
# credentials in a local env file.
DATABASE_ENV=development
SUPABASE_PROJECT_REF=YOUR_DEV_PROJECT_REF

# Runtime connection (use the development project's transaction pooler URL).
DATABASE_URL=postgresql://postgres.YOUR_DEV_PROJECT_REF:YOUR_DEV_PASSWORD@YOUR_DEV_POOLER_HOST:6543/postgres?pgbouncer=true

# Prisma CLI connection (use the development project's direct URL, or its
# session pooler on port 5432 when direct IPv6 connectivity is unavailable).
DIRECT_URL=postgresql://postgres:YOUR_DEV_PASSWORD@db.YOUR_DEV_PROJECT_REF.supabase.co:5432/postgres

# Download the public database CA certificate from Supabase Dashboard >
# Database Settings > SSL Configuration. Local Prisma database commands use
# the path. Application runtimes may instead set the complete PEM value.
SUPABASE_DB_CA_CERT_PATH=/absolute/path/to/prod-ca-2021.crt
# SUPABASE_DB_CA_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----

# Auth.js session encryption/signing secret. Generate a unique value for each
# environment; never commit a real secret.
AUTH_SECRET=YOUR_AUTH_SECRET
AUTH_URL=http://localhost:3000

# Google OAuth/OIDC web client credentials for local development. Configure
# separate credentials and callback URLs for deployed environments.
AUTH_GOOGLE_ID=YOUR_GOOGLE_CLIENT_ID
AUTH_GOOGLE_SECRET=YOUR_GOOGLE_CLIENT_SECRET
