# Copy this file to .env.local for local development. Never put production
# credentials in a local env file.
DATABASE_ENV=development
SUPABASE_PROJECT_REF=YOUR_DEV_PROJECT_REF

# Runtime connection (use the development project's transaction pooler URL).
DATABASE_URL=postgresql://postgres.YOUR_DEV_PROJECT_REF:YOUR_DEV_PASSWORD@YOUR_DEV_POOLER_HOST:6543/postgres?pgbouncer=true

# Prisma CLI connection (use the development project's direct URL, or its
# session pooler on port 5432 when direct IPv6 connectivity is unavailable).
DIRECT_URL=postgresql://postgres:YOUR_DEV_PASSWORD@db.YOUR_DEV_PROJECT_REF.supabase.co:5432/postgres
